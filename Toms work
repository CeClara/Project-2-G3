def find_orfs_in_frame(sequence, frame, strand='+', start_codons=None, stop_codons=None):
    """
    Scans a DNA sequence in a single reading frame to identify complete and partial ORFs.
    """
    # Defines start and stop Codons
    if start_codons is None:
        start_codons = ['ATG']
    if stop_codons is None:
        stop_codons = ['TAA', 'TAG', 'TGA']
# converst sequence to upper case incase it isnt
    sequence = sequence.upper()
    orfs = []
# stores the position of each codon
    triplets = []
    for i in range(frame, len(sequence) - 2, 3):
        triplets.append((sequence[i:i+3], i))
        
    current_start_idx = None
    has_valid_start = False
    potential_missing_start_idx = frame

    # Loops through all codons in the selected reading frame
    idx = 0
    while idx < len(triplets):
        codon, pos = triplets[idx]
        # If not currenlly inside an ORF
        if not has_valid_start:
             # Start a new ORF when a start codon is encountered
            if codon in start_codons:
                current_start_idx = pos
                has_valid_start = True
            elif codon in stop_codons:
                orf_len = pos + 3 - potential_missing_start_idx
                orfs.append({
                    'strand': strand,
                    'frame': frame + 1,  
                    'start_pos': potential_missing_start_idx,
                    'end_pos': pos + 3,
                    'length': orf_len,
                    'type': 'Partial (Missing Start)'
                })
                potential_missing_start_idx = pos + 3
        # if currently inside an ORF
        else:
            if codon in stop_codons:
                orf_len = pos + 3 - current_start_idx
                orfs.append({
                    'strand': strand,
                    'frame': frame + 1,
                    'start_pos': current_start_idx,
                    'end_pos': pos + 3,
                    'length': orf_len,
                    'type': 'Complete'
                })
                # Reset tracking variables to search for another ORF
                has_valid_start = False
                current_start_idx = None
                potential_missing_start_idx = pos + 3
                
        idx += 1

    last_processed_pos = triplets[-1][1] + 3 if triplets else frame
    # No stop codon was found
    if has_valid_start:
        orf_len = last_processed_pos - current_start_idx
        orfs.append({
            'strand': strand,
            'frame': frame + 1,
            'start_pos': current_start_idx,
            'end_pos': last_processed_pos,
            'length': orf_len,
            'type': 'Partial (Missing Stop)'
        })
# niether start or stops were found
    elif potential_missing_start_idx < last_processed_pos:
        orf_len = last_processed_pos - potential_missing_start_idx
        orfs.append({
            'strand': strand,
            'frame': frame + 1,
            'start_pos': potential_missing_start_idx,
            'end_pos': last_processed_pos,
            'length': orf_len,
            'type': 'Partial (Missing Both)'
        })

    return orfs


def get_reverse_complement(sequence):
    """
    Calculates the reverse complement of a DNA sequence.
    """
    complement = {'A': 'T', 'T': 'A', 'C': 'G', 'G': 'C', 'N': 'N'}
    # reverses the sequence and makes it upper case
    reversed_seq = sequence[::-1].upper()
    # complements the bases
    complement_seq = [complement.get(base, base) for base in reversed_seq]
    return "".join(complement_seq)

