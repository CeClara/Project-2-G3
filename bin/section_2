
# Function: validate_dna()
# - Check that the DNA sequence contains valid DNA characters.
# - Removes whitespace and converts the sequence to uppercase.
# - Decide how to handle unknown bases such as N.
# - Return whether the sequence is valid.


# dnaseq= imported from user 


#  DNA nucleotides
VALID_DNA_BASES = ['A', 'C', 'G', 'T']


# Function to clean seq
def validate_dna(dnaseq):
    clean_seq = "".join(dnaseq.split().upper())
    # Reject empty sequences
    if not clean_seq:
        return False

    # Check that every character is a valid DNA base
    for base in clean_seq:

        if base not in VALID_DNA_BASES :
            return False
    return clean_seq

# Function: load_dna()
# - Reads a DNA sequence from an uploaded or saved text file.
# - Validates the sequence after loading it.
# - Returns the cleaned sequence if valid, or False if invalid.

def load_dna(file_path):

    with open(file_path, "r", encoding="utf-8") as file:
        dnaseq = file.read()

    return validate_dna(dnaseq)
