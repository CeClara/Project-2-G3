
# ============================================================
# SECTION 2: DNA INPUT AND VALIDATION
# ============================================================

# Function: validate_dna()
# - Receives a DNA sequence.
# - Removes whitespace and converts it to uppercase.
# - Checks that only A, T, G and C are present.
# - Returns the cleaned sequence if valid, or False if invalid.

def validate_dna(dnaseq):

    # Remove whitespace and convert to uppercase
    clean_seq = "".join(dnaseq.split()).upper()

    # Reject empty sequences
    if not clean_seq:
        return False

    # Check that every character is a valid DNA base
    for base in clean_seq:
        if base not in VALID_DNA_BASES:
            return False

    return clean_seq


# Function: load_dna()
# - Reads DNA from an uploaded or saved text file.
# - Passes the file contents to validate_dna().
# - Returns the cleaned sequence if valid, or False if invalid.

def load_dna(file_path):

    with open(file_path, "r", encoding="utf-8") as file:
        dnaseq = file.read()

    return validate_dna(dnaseq)